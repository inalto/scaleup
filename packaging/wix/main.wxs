<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX 3 source for the ScaleUP Windows installer, generated by `cargo wix init` and edited.
  Build: cargo build (release, workspace) then cargo wix (package scaleup-app, nocapture, no-build).

  Variables set by `cargo wix`: TargetTriple, TargetEnv, TargetVendor, CargoTargetBinDir, CargoTargetDir,
  CargoProfile, Version. Paths below are relative to the repository root (run cargo wix from there).

  Installs into Program Files\ScaleUP\bin: both executables plus every library that `ort` copied next
  to them (DirectML.dll and the onnxruntime_providers DLLs); ONNX Runtime itself is linked statically.
  `ort` looks for those libraries in the executable directory, so they must stay together.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='ScaleUP'
        UpgradeCode='AB46794F-4ACF-4230-8EC7-DAC92AB9C4BB'
        Manufacturer='ScaleUP contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='ScaleUP: AI image upscaling with a before/after view'
            Manufacturer='ScaleUP contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <!-- AllowSameVersionUpgrades: MSI ignores the 4th version field, so v0.1.0-rc1 and v0.1.0
             share ProductVersion 0.1.0 and must still replace each other. -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='ScaleUP Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='ScaleUP'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='LICENSE'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='Readme' Guid='*'>
                        <File Id='ReadmeFile'
                            Name='README.md'
                            DiskId='1'
                            Source='README.md'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='059725D8-180D-4F35-B376-1F686ECD9CA0' KeyPath='yes'>
                            <!-- Per-machine install, so the machine PATH is extended; removed on uninstall. -->
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='scaleup-app.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\scaleup-app.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='scaleup.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\scaleup.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='directml' Guid='*'>
                            <File
                                Id='DirectML.dll'
                                Name='DirectML.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\DirectML.dll'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='ort_providers_shared' Guid='*'>
                            <File
                                Id='onnxruntime_providers_shared.dll'
                                Name='onnxruntime_providers_shared.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\onnxruntime_providers_shared.dll'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='ort_providers_cuda' Guid='*'>
                            <File
                                Id='onnxruntime_providers_cuda.dll'
                                Name='onnxruntime_providers_cuda.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\onnxruntime_providers_cuda.dll'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='ort_providers_tensorrt' Guid='*'>
                            <File
                                Id='onnxruntime_providers_tensorrt.dll'
                                Name='onnxruntime_providers_tensorrt.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\onnxruntime_providers_tensorrt.dll'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='ort_providers_nv_tensorrt_rtx' Guid='*'>
                            <File
                                Id='onnxruntime_providers_nv_tensorrt_rtx.dll'
                                Name='onnxruntime_providers_nv_tensorrt_rtx.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\onnxruntime_providers_nv_tensorrt_rtx.dll'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='ScaleUP'>
                    <Component Id='StartMenuShortcut' Guid='7F2C6E1A-5B64-4C7D-9C1E-2A9B0D3E4F55'>
                        <Shortcut Id='AppStartMenuShortcut'
                            Name='ScaleUP'
                            Description='AI image upscaling with a before/after view'
                            Target='[Bin]scaleup-app.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\ScaleUP' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the desktop app, the scaleup command line and the ONNX Runtime libraries.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='Readme'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='directml'/>
            <ComponentRef Id='ort_providers_shared'/>
            <ComponentRef Id='ort_providers_cuda'/>
            <ComponentRef Id='ort_providers_tensorrt'/>
            <ComponentRef Id='ort_providers_nv_tensorrt_rtx'/>
            <ComponentRef Id='StartMenuShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executables to the PATH environment variable so that scaleup can be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='assets/icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/inalto/scaleup'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='packaging/wix/License.rtf'/>

    </Product>

</Wix>
