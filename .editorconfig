root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,wxs,plist,desktop}]
indent_size = 2

[*.md]
max_line_length = 100
trim_trailing_whitespace = false

[*.{sh,py}]
indent_size = 4

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
