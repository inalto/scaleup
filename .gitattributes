# Shell scripts and workflow files must reach Linux and macOS runners with LF endings whatever the
# committer's core.autocrlf setting.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.desktop text eol=lf
packaging/deb/* text eol=lf
*.ps1 text eol=crlf
*.rtf text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.onnx binary
